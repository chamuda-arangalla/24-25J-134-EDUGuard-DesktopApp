<Window x:Class="EDUGuard_DesktopApp.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Dashboard" Height="600" Width="800" Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded TextBox Style -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Background="#0CB912" Grid.Row="0" Height="60">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="White"
                       VerticalAlignment="Center" Margin="15,0,0,0" />

            <!-- Buttons Panel -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,15,0">
                <!-- Settings Button -->
                <Button Width="40" Height="40" Margin="0,0,10,0" Click="SettingsButton_Click" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Image Source="/Assets/settings-icon.png" Width="20" Height="20" />
                </Button>

                <!-- Logout Button -->
                <Button Content="Logout" Width="100" Height="35" Click="LogoutButton_Click"
                        Background="#FF3B30" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Padding="5"
                        Style="{StaticResource RoundedButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Dashboard">
                <Border Background="White" Margin="10" Padding="20" CornerRadius="10">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="Model1Button" Content="Start Model 1" Click="Model1Button_Click"
                                Style="{StaticResource RoundedButtonStyle}" Width="200" Height="50"/>
                        <Button x:Name="Model2Button" Content="Start Model 2" Click="Model2Button_Click"
                                Style="{StaticResource RoundedButtonStyle}" Width="200" Height="50"/>
                        <Button x:Name="Model3Button" Content="Start Model 3" Click="Model3Button_Click"
                                Style="{StaticResource RoundedButtonStyle}" Width="200" Height="50"/>
                        <Button x:Name="Model4Button" Content="Start Model 4" Click="Model4Button_Click"
                                Style="{StaticResource RoundedButtonStyle}" Width="200" Height="50"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Reports">
                <Border Background="White" Margin="10" Padding="20" CornerRadius="10">
                    <Grid>
                        <lvc:PieChart Name="PostureChart" Height="300" Width="400">
                            <lvc:PieChart.Series>
                                <lvc:PieSeries Values="{Binding PostureValues}" Title="Good Posture" Fill="ForestGreen" />
                                <lvc:PieSeries Values="{Binding PostureValues}" Title="Bad Posture" Fill="OrangeRed" />
                            </lvc:PieChart.Series>
                        </lvc:PieChart>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Profile">
                <Border Background="White" Margin="10" Padding="20" CornerRadius="10">
                    <!-- Enable scrolling -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="User Profile" FontSize="22" FontWeight="Bold"
                           Foreground="#333" Margin="0,0,0,20" />

                            <!-- First Name -->
                            <TextBlock Text="First Name:" FontSize="14" Foreground="#666"/>
                            <TextBox x:Name="FirstNameTextBox" Width="300" Margin="0,5,0,10"
                         Style="{StaticResource RoundedTextBoxStyle}" />

                            <!-- Last Name -->
                            <TextBlock Text="Last Name:" FontSize="14" Foreground="#666"/>
                            <TextBox x:Name="LastNameTextBox" Width="300" Margin="0,5,0,10"
                         Style="{StaticResource RoundedTextBoxStyle}" />

                            <!-- Email -->
                            <TextBlock Text="Email:" FontSize="14" Foreground="#666"/>
                            <TextBox x:Name="EmailTextBox" Width="300" Margin="0,5,0,10"
                         IsEnabled="False" Style="{StaticResource RoundedTextBoxStyle}" />

                            <!-- Contact Number -->
                            <TextBlock Text="Contact Number:" FontSize="14" Foreground="#666"/>
                            <TextBox x:Name="ContactNumberTextBox" Width="300" Margin="0,5,0,20"
                         Style="{StaticResource RoundedTextBoxStyle}" />

                            <!-- Age -->
                            <TextBlock Text="Age:" FontSize="14" Foreground="#666"/>
                            <TextBox x:Name="AgeTextBox" Width="300" Margin="0,5,0,20"
                         Style="{StaticResource RoundedTextBoxStyle}" />

                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <Button Content="Update" Width="100" Click="UpdateButton_Click"
                            Background="#007AFF" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Padding="5"
                            Style="{StaticResource RoundedButtonStyle}" Margin="0,0,10,0"/>
                                <Button Content="Delete Account" Width="150" Click="DeleteButton_Click"
                            Background="#FF3B30" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Padding="5"
                            Style="{StaticResource RoundedButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>

</Window>
