<Window x:Class="EDUGuard_DesktopApp.Utilities.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Height="150" Width="385"
        WindowStyle="None" 
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Background="White" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="366" Height="130">
            <!-- Content: Warning icon and centered text -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="335" Height="105">
                <!-- Warning Icon -->
                <Image Source="/EDUGuard_DesktopApp;component/Assets/warning.png" 
                       Width="32" Height="32" Margin="0,0,10,0"/>
                <!-- Centered Text -->
                <TextBlock x:Name="MessageTextBlock"
                           Text="Your message here"
                           TextAlignment="Center"
                           FontSize="14"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <!-- Styled OK Button -->
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="65"
                    Height="20"
                    HorizontalAlignment="Right"
                    Margin="0,0,5,0"
                    Click="OkButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFDDDDDD"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="Gray"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>
